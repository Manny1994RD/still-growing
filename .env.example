# Copy to .env and change these values before running `docker compose up`.

# Database password (any long random string)
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Secret used to sign login tokens: at least 32 characters
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters

# API address baked into the web app. "/api" = same address as the web app.
PUBLIC_API_URL=/api

# Comma-separated origins allowed to call the API from a browser ("*" = any)
CORS_ORIGIN=*

API_PORT=4000
WEB_PORT=8080

# Optional: Cloudflare Tunnel token for secure access from anywhere.
# Start with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
